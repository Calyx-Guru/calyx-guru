NODE_ENV=development

# Supabase Configuration
# Get these values from your Supabase project settings at https://supabase.com
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_DB_PASSWORD=your_supabase_db_password_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
EXPO_PUBLIC_USE_MOCK_DATA=false

# Local use only
DASHBOARD_ADMIN_EMAIL=email
DASHBOARD_ADMIN_PASSWORD=password
EXPO_PUBLIC_DEBUG_MODE=false

# Google Sign-In (Gmail) — authenticates with Google only; Supabase uses the email for savedata paths.
# Create OAuth clients in Google Cloud Console (Web + Android; iOS if needed).
# You do NOT need to enable the Google provider in Supabase Auth.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
# iOS client ID (required for iOS builds only)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
# Reversed iOS client ID for the Expo config plugin (e.g. com.googleusercontent.apps.123456789-abc)
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.your_ios_client_suffix

GEMINI_API_KEY=your_gemini_api_key_here

# Android Release Signing
CALYXGURU_RELEASE_STORE_PASSWORD=your_release_store_password_here
CALYXGURU_RELEASE_KEY_ALIAS=your_release_key_alias_here
CALYXGURU_RELEASE_KEY_PASSWORD=your_release_key_password_here

# Amplitude
EXPO_PUBLIC_AMPLITUDE_API_KEY=your_amplitude_api_key_here

# GameAnalytics
EXPO_PUBLIC_GAME_ANALYTICS_GAME_KEY=your_game_analytics_game_key_here
EXPO_PUBLIC_GAME_ANALYTICS_SECRET_KEY=your_game_analytics_secret_key_here